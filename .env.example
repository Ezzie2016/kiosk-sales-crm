# Copy to .env and fill in. The CRM only ever uses the anon/publishable key in the
# browser; all authorization is enforced by Postgres row-level security in the `crm`
# schema, so the anon key can only ever see what the signed-in staff member is allowed to see.

# Which environment this build points at: development | preview | production
# Fails safe: an EnvironmentBanner shows unless this is exactly "production".
VITE_APP_ENV=development

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
